generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(uuid())
  username          String           @unique
  email             String           @unique
  phone             String
  password          String
  fullName          String
  role              Role             @default(CITIZEN)
  isVerified        Boolean          @default(false)
  verificationToken String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  fcmToken          String?
  announcements     Announcement[]   @relation("AdminAnnouncements")
  employeeProfile   Employee?
  notifications     Notification[]
  ticketsCreated    Ticket[]         @relation("CitizenTickets")
  timelineActions   TicketTimeline[] @relation("TimelineActor")
}

model Employee {
  id              String   @id @default(uuid())
  employeeId      String   @unique
  userId          String   @unique
  department      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  photo           String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaves          Leave[]
  assignedTickets Ticket[] @relation("EmployeeTickets")
}

model Leave {
  id         String      @id @default(uuid())
  employeeId String
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     LeaveStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Ticket {
  id                 String           @id @default(uuid())
  ticketId           String           @unique
  citizenId          String
  category           String
  title              String
  description        String
  location           String
  alternatePhone     String?
  issueImage         String?
  completionImage    String?
  status             TicketStatus     @default(PENDING)
  rejectReason       String?
  remarks            String?
  expectedCompletion DateTime?
  employeeId         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedByCitizen   Boolean          @default(false)
  notifications      Notification[]   @relation("TicketNotifications")
  citizen            User             @relation("CitizenTickets", fields: [citizenId], references: [id], onDelete: Cascade)
  assignedEmployee   Employee?        @relation("EmployeeTickets", fields: [employeeId], references: [id])
  timeline           TicketTimeline[]
}

model TicketTimeline {
  id                 String       @id @default(uuid())
  ticketId           String
  status             TicketStatus
  remarks            String?
  expectedCompletion DateTime?
  actorId            String
  createdAt          DateTime     @default(now())
  actor              User         @relation("TimelineActor", fields: [actorId], references: [id])
  ticket             Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  adminId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contentTe String?
  titleTe   String?
  admin     User     @relation("AdminAnnouncements", fields: [adminId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  ticketId  String?
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    Ticket?  @relation("TicketNotifications", fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HomepageSection {
  id        String   @id @default(uuid())
  key       String   @unique
  title     String
  content   String
  updatedAt DateTime @updatedAt
  contentTe String?
  titleTe   String?
}

model AboutGP {
  id                     String   @id @default(uuid())
  gpName                 String
  mandal                 String
  district               String
  formationDetails       String
  proceedingsNumber      String
  gpExtent               String
  panchayatSecretary     String
  executiveOfficer       String
  malePopulation         Int
  femalePopulation       Int
  population             Int
  scPopulation           Int
  stPopulation           Int
  totalAssessments       Int
  auditStatus            String
  updatedAt              DateTime @updatedAt
  apiicEstate04          String   @default("-")
  apiicEstate37          String   @default("-")
  apiicTotalAcres        String   @default("-")
  communityHallLocation  String   @default("-")
  fposInGp               String   @default("-")
  libraryLocation        String   @default("-")
  misappropriationAmount String   @default("-")
  misappropriationCases  String   @default("-")
  npa                    String   @default("-")
  pnpa                   String   @default("-")
  recoveryAmount         String   @default("-")
  savingsAchievement     String   @default("-")
  savingsPercentage      String   @default("-")
  savingsTarget          String   @default("-")
  sriNidhiAmount         String   @default("-")
  sriNidhiLoansGranted   String   @default("-")
}

model CustomSectionField {
  id         String   @id @default(uuid())
  sectionKey String
  fieldName  String
  fieldValue String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Official {
  id               String   @id @default(uuid())
  name             String
  designation      String
  phoneNumber      String
  office           String
  responsibilities String
  photo            String?
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  designationTe    String?
  nameTe           String?
}

model WaterDetails {
  id                  String   @id @default(uuid())
  totalWaterSchemes   Int
  privateConnections  Int
  publicConnections   Int
  handPumps           Int
  privateTapFeeDemand Float
  totalOHSRs          Int
  totalGLSRs          Int
  totalDirectPumping  Int
  updatedAt           DateTime @updatedAt
}

model OHSR {
  id              String   @id @default(uuid())
  name            String
  capacity        Float
  pumpingCapacity Float?
  location        String
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GLSR {
  id              String   @id @default(uuid())
  name            String
  capacity        Float
  pumpingCapacity Float?
  location        String
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DirectPumping {
  id        String   @id @default(uuid())
  pumpName  String
  source    String
  capacity  Float
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StreetLightDetails {
  id            String   @id @default(uuid())
  totalPoles    Int
  totalLEDs     Int
  lightingStaff Int
  updatedAt     DateTime @updatedAt
}

model StreetLightAsset {
  id              String    @id @default(uuid())
  area            String
  poleCount       Int
  ledCount        Int
  workingStatus   String
  lastMaintenance DateTime?
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model TaxRevenue {
  id                   String   @id @default(uuid())
  financialYear        String
  houseTax             Float
  libraryCess          Float
  waterTax             Float
  lightingTax          Float
  drainageTax          Float
  sportsTax            Float
  fireCess             Float
  totalDemand          Float
  houseTaxCollection   Float
  collectionPercentage Float
  nonTaxDemand         Float
  nonTaxCollection     Float
  pendingAmount        Float
  generalFund          Float
  tfc                  Float
  sfc                  Float
  ffc                  Float
  fifteenthFC          Float
  otherGrants          Float
  updatedAt            DateTime @updatedAt
}

model HealthDetails {
  id           String   @id @default(uuid())
  hospitalName String
  healthCentre String
  ashaWorkers  Int
  anms         Int
  updatedAt    DateTime @updatedAt
}

model HealthStaff {
  id          String   @id @default(uuid())
  name        String
  designation String
  phone       String
  area        String
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model School {
  id         String   @id @default(uuid())
  schoolName String
  type       String
  category   String
  location   String
  boys       Int
  girls      Int
  total      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AnganwadiCentre {
  id         String   @id @default(uuid())
  centreName String
  location   String
  boys       Int
  girls      Int
  total      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AnganwadiStats {
  id          String   @id @default(uuid())
  samChildren Int
  mamChildren Int
  updatedAt   DateTime @updatedAt
}

model MgnregsDetails {
  id                String   @id @default(uuid())
  jobCards          Int
  activeJobCards    Int
  works             Int
  estimateCost      Float
  gokulamSheds      Int
  sramikaSanghalu   Int
  completedGokulam  Int
  inProgressGokulam Int
  notStartedGokulam Int
  updatedAt         DateTime @updatedAt
}

model MgnregsWork {
  id        String   @id @default(uuid())
  workName  String
  village   String
  budget    Float
  status    String
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PensionCategory {
  id            String   @id @default(uuid())
  category      String
  beneficiaries Int
  monthlyAmount Float
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AgricultureStats {
  id                       String   @id @default(uuid())
  cultivableLand           Float
  rabiArea                 Float
  landSown                 Float
  groundnutQuintals        Float
  polamBadies              Int
  samplesCollected         Int
  samplesAnalysed          Int
  soilCards                Int
  pmKisan                  Int
  amountPaid               Float
  updatedAt                DateTime @updatedAt
  cropInsuranceFarmers     Int      @default(0)
  heavyRainAffectedFarmers Int      @default(0)
  heavyRainDamageAmount    Float    @default(0.0)
  heavyRainDamageArea      Float    @default(0.0)
}

model HorticultureStats {
  id           String   @id @default(uuid())
  area         Float
  production   Float
  midhPhysical Int
  midhTotal    Float
  rkvmPhysical Int
  rkvmTotal    Float
  updatedAt    DateTime @updatedAt
}

model AnimalHusbandryStats {
  id                 String   @id @default(uuid())
  cattle             Int
  buffaloes          Int
  sheep              Int
  goats              Int
  vaccination        Float
  insurance          Float
  projects           Float
  subsidy            Float
  fodderDev          Float
  targetFodder       Float
  pashubheemaInsured Int
  treatedSanchara    Int
  gokulamInaugurated Int
  gokulamSanctioned  Int
  nlmSanctioned      Int
  nlmCompleted       Int
  nlmInProgress      Int
  nlmSubsidy         Float
  updatedAt          DateTime @updatedAt
}

model VoGroup {
  id        String   @id @default(uuid())
  voName    String
  village   String
  members   Int
  president String
  phone     String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShgStats {
  id           String   @id @default(uuid())
  totalSHGs    Int
  activeSHGs   Int
  loans        Float
  savings      Float
  recovery     Float
  pmjby        Int
  pmsby        Int
  unnati       Int
  nutriGardens Int
  sriNidhi     Float
  updatedAt    DateTime @updatedAt
}

model CommunityAssetItem {
  id        String   @id @default(uuid())
  name      String
  location  String
  condition String
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PensionRecord {
  id           String   @id @default(uuid())
  sno          Int
  sgswCode     String
  sgswName     String
  pensionId    String   @unique
  name         String
  scheme       String
  monthAmount  Float
  mobileNumber String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  CITIZEN
  EMPLOYEE
  ADMIN
}

enum TicketStatus {
  PENDING
  ACCEPTED
  REJECTED
  ASSIGNED
  ON_WAY
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CLOSED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}
