}

model MgnregsWork {
  id        String   @id @default(uuid())
  workName  String
  village   String
  budget    Float
  status    String
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PensionCategory {
  id            String   @id @default(uuid())
  category      String   // OAP, Widow, Disabled, Weavers, etc.
  beneficiaries Int
  monthlyAmount Float
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

